# AIMF Backend — Environment Variables
# Copy this file to .env and fill in real values
# .env is gitignored — NEVER commit real secrets

# ─── Application ─────────────────────────────────────────────────────────────
AIMF_ENV=development
AIMF_LOG_LEVEL=INFO
AIMF_CORS_ORIGINS=http://localhost:5173

# ─── REQUIRED: Encryption Key ─────────────────────────────────────────────────
# Generate with:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Application will FAIL TO START if this is missing or wrong length.
AIMF_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_32_BYTE_BASE64_KEY

# ─── Database ────────────────────────────────────────────────────────────────
AIMF_DATABASE_URL=sqlite:///./aimf.db
# PostgreSQL example:
# AIMF_DATABASE_URL=postgresql+asyncpg://aimf_user:password@localhost:5432/aimf

# ─── AI Models ───────────────────────────────────────────────────────────────
AIMF_EMBEDDING_MODEL=all-MiniLM-L6-v2
AIMF_SPACY_MODEL=en_core_web_sm
AIMF_FAISS_INDEX_PATH=./faiss_index.bin

# ─── AMGS Weights (v1 — sum of positives=0.75, penalties=0.25) ───────────────
AIMF_WEIGHT_U=0.25
AIMF_WEIGHT_C=0.15
AIMF_WEIGHT_F=0.15
AIMF_WEIGHT_N=0.20
AIMF_WEIGHT_R=0.10
AIMF_WEIGHT_P=0.10
AIMF_WEIGHT_D=0.05

# ─── Decision Thresholds ─────────────────────────────────────────────────────
AIMF_THRESHOLD_LONG_TERM=0.75
AIMF_THRESHOLD_STORE=0.50
AIMF_THRESHOLD_SUMMARIZE=0.30
AIMF_THRESHOLD_FORGET=0.15
AIMF_THRESHOLD_ENCRYPT=0.85
AIMF_THRESHOLD_REJECT_PRIV=0.95
AIMF_THRESHOLD_REDUNDANCY=0.85

# ─── Memory Lifecycle ────────────────────────────────────────────────────────
AIMF_DECAY_FUNCTION=exponential
AIMF_DECAY_HALF_LIFE_DAYS=30
AIMF_EXPIRY_CHECK_INTERVAL_HOURS=1
AIMF_FORGETTING_TASK_INTERVAL_HOURS=24
AIMF_CONTEXT_WINDOW_SIZE=10
AIMF_CONTEXT_WINDOW_MINUTES=30

# ─── Experiments ─────────────────────────────────────────────────────────────
AIMF_EXPERIMENT_SEED=42
AIMF_EXPERIMENT_DB_PATH=./experiment.db
